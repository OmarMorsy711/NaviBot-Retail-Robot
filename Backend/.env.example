# Postgres connection string for the Supabase database (Project Settings > Database)
DATABASE_URL=

# Supabase project URL, e.g. https://<project-ref>.supabase.co
SUPABASE_URL=

# Supabase anon (public) key, served to the dashboards for Realtime
SUPABASE_ANON_KEY=

# Supabase service role key, used server side for Storage uploads and alerts
SUPABASE_SERVICE_ROLE_KEY=

# Supabase Storage bucket that holds product and reference images
PRODUCT_BUCKET=images

# Table that receives patrol alerts
ALERT_TABLE=alerts

# Folder inside the bucket that holds the reference shelf images
REFERENCE_PREFIX=refrences

# Dashboard account created by create_user.py ("John Doe" opens the employee dashboard, any other name the admin dashboard)
ADMIN_USERNAME=admin

# Password for that account (required by create_user.py)
ADMIN_PASSWORD=
