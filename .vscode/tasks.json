{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Launch Full Stack",
            "dependsOn": [
                "Run Backend",
                "Run Frontend",
                "Run CV Server"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": []
        },
        {
            "label": "Run Backend",
            "type": "shell",
            "command": "cd backend; .\\.venv\\Scripts\\python.exe -m uvicorn app:app --reload",
            "presentation": {
                "panel": "dedicated",
                "group": "backend"
            }
        },
        {
            "label": "Run Frontend",
            "type": "shell",
            "command": "cd navibot-server; node server.js",
            "presentation": {
                "panel": "dedicated",
                "group": "frontend"
            }
        },
        {
            "label": "Run CV Server",
            "type": "shell",
            "command": "cd OpenCV; .\\.venv\\Scripts\\python.exe app_camera.py",
            "presentation": {
                "panel": "dedicated",
                "group": "cv"
            }
        }
    ]
}